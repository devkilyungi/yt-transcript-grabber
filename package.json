{
  "name": "yt-transcript-grabber",
  "version": "2.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Paste a YouTube link, get a clean, paragraphed transcript.",
  "scripts": {
    "dev": "next dev --port 8765",
    "build": "next build",
    "start": "next start --port 8765",
    "typecheck": "tsc --noEmit",
    "build:server": "next build && node scripts/prepare-standalone.mjs",
    "app": "npm run build:server && electron electron",
    "app:package": "npm run build:server && electron-builder --mac",
    "app:install": "npm run app:package && ditto dist/mac*/'Transcript Grabber.app' '/Applications/Transcript Grabber.app'",
    "app:icon": "electron scripts/render-icon.cjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "youtubei.js": "18.1.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9"
  },
  "build": {
    "appId": "com.devkilyungi.transcriptgrabber",
    "productName": "Transcript Grabber",
    "copyright": "Copyright (C) 2026 Victor Kilyungi",
    "directories": {
      "app": "electron",
      "buildResources": "build",
      "output": "dist"
    },
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "server",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null
    },
    "afterPack": "./scripts/after-pack.cjs",
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json",
      "!node_modules/**"
    ]
  }
}
